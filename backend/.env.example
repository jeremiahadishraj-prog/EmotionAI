# Copy this file to .env, then paste your key. NEVER share or commit .env.
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here

# The website addresses allowed to call this server (comma separated, no spaces, no trailing slash).
# Both forms are listed because VS Code Live Server uses 127.0.0.1.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Optional: change models (see console.groq.com/docs/models for current names)
CHAT_MODEL=llama-3.3-70b-versatile
QUICK_MODEL=llama-3.1-8b-instant

# Optional limits to protect your quota
RATE_PER_MINUTE=20
DAILY_CAP=3000
MAX_TOKENS=1024

# Set to 1 only when deployed behind a proxy such as Render or Railway
TRUST_PROXY=0

# To use Anthropic instead:  LLM_PROVIDER=anthropic  and  ANTHROPIC_API_KEY=...
DEBUG_ERRORS=1